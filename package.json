{
  "name": "localdesk-ai",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "LocalDesk AI by Solomon Gbeta. Tauri desktop and local mobile PWA.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release:check": "node scripts/check-release.mjs",
    "catalog:refresh": "node scripts/generate-mobile-catalog.mjs --refresh"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.0.18",
    "workbox-precaching": "7.4.0",
    "workbox-routing": "7.4.0"
  }
}
